# Copy this file to .env and replace every example value locally.
APP_HOST=127.0.0.1
APP_PORT=8000
REFRESH_MINUTES=15

ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

JIRA_SITE_A_URL=
JIRA_SITE_B_URL=
JIRA_SITE_C_URL=

# Configure only the queries you intend to run. Use your own project key.
JIRA_SITE_A_JQL=project = YOUR_PROJECT_KEY AND statusCategory != Done
JIRA_SITE_A_SECONDARY_JQL=project = YOUR_PROJECT_KEY AND text ~ "YOUR_SEARCH_TERM"
JIRA_SITE_B_JQL=
JIRA_SITE_B_SECONDARY_JQL=
JIRA_SITE_C_JQL=
JIRA_SITE_C_SECONDARY_JQL=
